          break;
        }

        case 'depreciation': {
          const depreciable = v1 - v2;
          const annual = depreciable / v3;
          const monthly = annual / 12;
          out = `Annual Depreciation: ${fmt(annual)} <br/> Monthly: ${fmt(monthly)} <br/> Total Depreciable: ${fmt(depreciable)}`;
          cLabels = ['Salvage Value', 'Total Depreciation'];
          cData = [v2, depreciable];
          break;
        }

        case 'eps': {
          const earnings = v1 - v2;
          const epsVal = earnings / v3;
          out = `EPS: ${fmt(epsVal)} <br/> Total Earnings: ${fmt(earnings)}`;
          cLabels = ['Preferred Dividends', 'Net Earnings'];
          cData = [v2, earnings > 0 ? earnings : 0];
          break;
        }

        case 'retention': {
          const retained = v3 - v2;
          const retentionRate = (retained / v1) * 100;
          const churnRate = 100 - retentionRate;
          out = `Retention Rate: ${pct(retentionRate)} <br/> Churn Rate: ${pct(churnRate)} <br/> Retained Customers: ${retained.toFixed(0)}`;
          cLabels = ['Retained', 'Churned'];
          cData = [retained > 0 ? retained : 0, v1 - retained > 0 ? v1 - retained : 0];
          break;
        }

        case 'real_estate': {
          const netIncome = v1 - v2;
          const roiPct = v3 > 0 ? (netIncome / v3) * 100 : 0;
          const capRate = roiPct;
          out = `Annual Net Income: ${fmt(netIncome)} <br/> ROI / Cap Rate: ${pct(capRate)} <br/> Property Value: ${fmt(v3)}`;
          cLabels = ['Operating Expenses', 'Net Income'];
          cData = [v2, netIncome > 0 ? netIncome : 0];
          break;
        }

        case 'platform_margin': {
          const grossProfit = v1 - v2 - v3;
          const marginPct = v1 > 0 ? (grossProfit / v1) * 100 : 0;
          out = `Net Profit: ${fmt(grossProfit)} <br/> Profit Margin: ${pct(marginPct)} <br/> Total Costs: ${fmt(v2 + v3)}`;
          cLabels = ['COGS', 'Platform Fees', 'Net Profit'];
          cData = [v2, v3, grossProfit > 0 ? grossProfit : 0];
          break;
        }

        case 'savings_goal': {
          const r = (v2 / 100) / 12;
          const n = v3;
          let monthly;
          if (r === 0) {
            monthly = v1 / n;
          } else {
            monthly = (v1 * r) / (Math.pow(1 + r, n) - 1);
          }
          const totalSaved = monthly * n;
          const totalInterest = v1 - totalSaved;
          out = `Monthly Savings Needed: ${fmt(monthly)} <br/> Total You Save: ${fmt(totalSaved)} <br/> Interest Earned: ${fmt(Math.abs(totalInterest))}`;
          cLabels = ['Your Contributions', 'Interest Earned'];
          cData = [totalSaved, Math.abs(totalInterest)];
          break;
        }

        case 'retirement': {
          const annualExpense = v1 * 12;
          const nestEgg = v3 > 0 ? (annualExpense / v3) * 100 : annualExpense * 25;
          const totalExpense = annualExpense * v2;
          out = `Required Nest Egg: ${fmt(nestEgg)} <br/> Annual Expense: ${fmt(annualExpense)} <br/> Total Over ${v2} Years: ${fmt(totalExpense)}`;
          cLabels = ['Nest Egg Needed', 'Total Expenses'];
          cData = [nestEgg, totalExpense];
          break;
        }

        case 'freelance_tax': {
          const netIncome = v1 - v2;
          const seTax = netIncome * 0.153;
          const seTaxDeduction = seTax * 0.5;
          const taxableIncome = netIncome - seTaxDeduction;
          const incomeTax = taxableIncome * (v3 / 100);
          const totalTax = seTax + incomeTax;
          const takeHome = netIncome - totalTax;
          out = `Take-Home Pay: ${fmt(takeHome)} <br/> Self-Employment Tax: ${fmt(seTax)} <br/> Income Tax: ${fmt(incomeTax)} <br/> Total Tax: ${fmt(totalTax)}`;
          cLabels = ['Take-Home', 'SE Tax', 'Income Tax'];
          cData = [takeHome > 0 ? takeHome : 0, seTax, incomeTax];
          break;
        }

        case 'invoice_discount': {
          const discount = v1 * (v2 / 100);
          const afterDiscount = v1 - discount;
          const taxAmount = afterDiscount * (v3 / 100);
          const finalTotal = afterDiscount + taxAmount;
          out = `Final Invoice: ${fmt(finalTotal)} <br/> Discount Saved: ${fmt(discount)} <br/> Tax Amount: ${fmt(taxAmount)} <br/> After Discount: ${fmt(afterDiscount)}`;
          cLabels = ['After Discount', 'Tax', 'Discount Saved'];
          cData = [afterDiscount, taxAmount, discount];
          break;
        }

        case 'markup': {
          const sellingPrice = v1 / (1 - v2 / 100);
          const markupPct = ((sellingPrice - v1) / v1) * 100;
          const profit = sellingPrice - v1;
          out = `Selling Price: ${fmt(sellingPrice)} <br/> Markup: ${pct(markupPct)} <br/> Profit: ${fmt(profit)}`;
          cLabels = ['Cost Price', 'Profit'];
          cData = [v1, profit];
          break;
        }

        case 'email_roi': {
          const openRate = v1 > 0 ? (v2 / v1) * 100 : 0;
          const revenuePerEmail = v1 > 0 ? v3 / v1 : 0;
          const revenuePerOpen = v2 > 0 ? v3 / v2 : 0;
          out = `Open Rate: ${pct(openRate)} <br/> Revenue per Email: ${fmt(revenuePerEmail)} <br/> Revenue per Open: ${fmt(revenuePerOpen)} <br/> Total Revenue: ${fmt(v3)}`;
          cLabels = ['Opened', 'Not Opened'];
          cData = [v2, v1 - v2];
          break;
        }

        case 'payroll_tax': {
          const salary = v1;
          const payPeriods = v2 > 0 ? v2 : 12;
          const ssCap = 176100;
          const socialSecurity = Math.min(salary, ssCap) * 0.062;
          const medicare = salary * 0.0145;
          const futa = Math.min(salary, 7000) * 0.06;
          const totalTax = socialSecurity + medicare + futa;
          const totalCost = salary + totalTax;
          const perPeriod = totalCost / payPeriods;
          out = `Total Employer Cost: ${fmt(totalCost)} <br/> Social Security: ${fmt(socialSecurity)} <br/> Medicare: ${fmt(medicare)} <br/> FUTA: ${fmt(futa)} <br/> Per Pay Period: ${fmt(perPeriod)}`;
          cLabels = ['Base Salary', 'SS Tax', 'Medicare', 'FUTA'];
          cData = [salary, socialSecurity, medicare, futa];
          break;
        }
        ase 'rent_vs_buy': {
          const homePrice = v1;
          const monthlyRent = v2;
          const years = v3 > 0 ? v3 : 7;

          if (!homePrice || homePrice <= 0 || !monthlyRent || monthlyRent <= 0) {
            resDiv.innerHTML = '⚠️ Please enter a valid home price and monthly rent.';
            resDiv.style.display = 'block';
            if (e?.isTrusted) resDiv.scrollIntoView({ behavior: 'smooth', block: 'center' });
            return;
          }

          // Assumptions for realistic calculation
          const downPayment = homePrice * 0.20;
          const loanAmount = homePrice - downPayment;
          const rateAnnual = 6.5;
          const r = (rateAnnual / 12) / 100;
          const months = Math.round(years * 12);

          const emi = r > 0
            ? (loanAmount * r * Math.pow(1 + r, months)) / (Math.pow(1 + r, months) - 1)
            : loanAmount / months;

          const annualTaxRate = 0.011; // 1.1% property tax
          const annualMaintRate = 0.01; // 1% maintenance
          const annualAppreciation = 0.03; // 3% home value growth

          let totalRentPaid = 0;
          let currentRent = monthlyRent;
          let totalBuyingCost = downPayment + (emi * months);
          let propertyVal = homePrice;

          for (let y = 1; y <= years; y++) {
            totalRentPaid += currentRent * 12;
            currentRent *= 1.03; // rent inflation 3% / yr

            // Add annual tax & maintenance to buying cost
            const annualTax = propertyVal * annualTaxRate;
            const annualMaint = propertyVal * annualMaintRate;
            totalBuyingCost += annualTax + annualMaint;

            propertyVal *= (1 + annualAppreciation);
          }

          // Selling cost at the end (approx 6% realtor/closing fee)
          const sellingCost = propertyVal * 0.06;
          const finalHomeEquity = propertyVal - (loanAmount * 0.7) - sellingCost; // rough remaining balance estimation
          const netBuyingCost = totalBuyingCost - finalHomeEquity;

          const diff = Math.abs(netBuyingCost - totalRentPaid);
          const winner = netBuyingCost < totalRentPaid ? "Buying is Cheaper 🏠" : "Renting is Cheaper 🏢";

          out = `
            <div style="background:linear-gradient(135deg, #1e3a8a, #1e40af); color:white; padding:22px; border-radius:14px; margin-bottom:18px;">
              <p style="margin:0; opacity:0.9; font-size:0.9rem;">Over ${years} Years Recommendation</p>
              <h2 style="margin:6px 0 0; font-size:2rem; color:#60a5fa;">${winner}</h2>
            </div>
            <div style="text-align:left; font-size:1rem; line-height:2;">
              <div style="display:flex; justify-content:space-between;"><span>Total Rent Cost:</span><strong>${fmt(totalRentPaid)}</strong></div>
              <div style="display:flex; justify-content:space-between;"><span>Net Buying Cost ( incl. taxes & maintenance ):</span><strong>${fmt(netBuyingCost)}</strong></div>
              <hr style="border:0; border-top:1px solid #e2e8f0; margin:8px 0;">
              <div style="display:flex; justify-content:space-between; font-size:1.2rem; color:#1e3a8a;"><span>Financial Advantage:</span><strong>Save ${fmt(diff)}</strong></div>
            </div>
          `;

          cLabels = ['Total Rent Paid', 'Net Buying Cost'];
          cData = [totalRentPaid, netBuyingCost > 0 ? netBuyingCost : 0];
          break;
        }
        default: {
          out     = `Result: ${fmt(v1 * v2)}`;
          cLabels = ['Value 1', 'Value 2'];
          cData   = [v1, v2];
        }
      }

      resDiv.innerHTML      = out;
      resDiv.style.display  = 'block';

      if (cData.length > 0) updateChart(cLabels, cData);

      // শুধুমাত্র ইউজার বাটনে সরাসরি ক্লিক করলে স্ক্রল করবে
      if (e && e.isTrusted) {
        resDiv.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    });

    // ✨ ডেমো ডেটা লোডার: সব ৫৩টি ফর্মুলার বাস্তবসম্মত ইনপুট
    function loadDemoData() {
      const f = window.currentFormula;
      const v1 = document.getElementById('v1');
      const v2 = document.getElementById('v2');
      const v3 = document.getElementById('v3');
      const v4 = document.getElementById('v4');
      const v5 = document.getElementById('v5');
      const v6 = document.getElementById('v6');
      const v7 = document.getElementById('v7');

      if (!v1) return;

      switch(f) {
        case 'mortgage':
          v1.value = '400000'; // Home Price
          if (v2) v2.value = '20'; // 20% Down Payment
          if (v3) v3.value = '6.5'; // Rate %
          if (v4) v4.value = '30'; // 30 Years
          if (v5) v5.value = '4400'; // Prop Tax
          if (v6) v6.value = '1200'; // Home Insurance
          if (v7) v7.value = '50'; // HOA
          break;

        case 'car_loan':
          v1.value = '35000'; // Vehicle Price
          if (v2) v2.value = '10'; // 10% Down
          if (v3) v3.value = '5.9'; // Rate %
          if (v4) v4.value = '60'; // 60 Months
          if (v5) v5.value = '3000'; // Trade-in
          if (v6) v6.value = '6.5'; // Sales Tax
          if (v7) v7.value = '450'; // Fees
          break;

        case 'personal_loan':
          v1.value = '20000'; // Loan Amount
          if (v2) v2.value = '9.5'; // Rate %
          if (v3) v3.value = '36'; // 36 Months
          if (v4) v4.value = '3'; // 3% Origination Fee
          break;

        case 'loan':
          v1.value = '25000'; // Principal
          if (v2) v2.value = '7.5'; // Rate %
          if (v3) v3.value = '48'; // 48 Months
          break;

        case 'sip':
          v1.value = '500'; // Monthly SIP
          if (v2) v2.value = '12'; // Return %
          if (v3) v3.value = '10'; // 10 Years
          if (v4) v4.value = '10'; // 10% Step up
          if (v5) v5.value = '5'; // 5% Inflation
          break;

        case 'roi':
          v1.value = '15000'; // Total Revenue
          if (v2) v2.value = '10000'; // Cost
          break;

        case 'marketing_roi':
          v1.value = '25000'; // Revenue
          if (v2) v2.value = '5000'; // Ad Spend
          if (v3) v3.value = '8000'; // COGS
          if (v4) v4.value = '120'; // Customers
          if (v5) v5.value = '250'; // LTV
          break;

        case 'runway':
          v1.value = '150000'; // Cash in hand
          if (v2) v2.value = '20000'; // Monthly burn
          if (v3) v3.value = '5000'; // Monthly rev
          break;

        case 'margin':
          v1.value = '50000'; // Revenue
          if (v2) v2.value = '32000'; // Cost
          if (v3) v3.value = '50000';
          break;

        case 'stock':
          v1.value = '120'; // Buy Price
          if (v2) v2.value = '175'; // Sell Price
          if (v3) v3.value = '50'; // Shares
          break;

        case 'uk_pension':
          v1.value = '200000'; // Pot
          if (v2) v2.value = '25000'; // Withdrawal
          if (v3) v3.value = '2024';
          break;

        case 'salary_sacrifice':
          v1.value = '45000'; // Salary
          if (v2) v2.value = '5'; // 5% sacrifice
          if (v3 && v3.tagName === 'SELECT') v3.selectedIndex = 1;
          break;

        case 'tax':
          v1.value = '1500'; // Amount
          if (v2) v2.value = '8.25'; // Tax Rate %
          break;

        case 'usa_sales_tax':
          v1.value = '100'; // Amount
          if (v2) v2.value = '7.5'; // Rate %
          if (v3) v3.value = '1'; // Mode 1 = Add tax
          break;

        case 'ca_gst_hst':
          v1.value = '150'; // Amount
          if (v2 && v2.tagName === 'SELECT') v2.selectedIndex = 1;
          if (v3) v3.value = '1';
          break;

        case 'compound':
          v1.value = '10000'; // Initial
          if (v2) v2.value = '7'; // Rate %
          if (v3) v3.value = '10'; // Years
          break;

        case 'dividend':
          v1.value = '4.5'; // Annual Dividend
          if (v2) v2.value = '100'; // Stock Price
          if (v3) v3.value = '150'; // Shares
          break;

        case 'ratio':
          v1.value = '1920';
          if (v2) v2.value = '1080';
          break;

        case 'fee':
          v1.value = '1000'; // Amount
          if (v2) v2.value = '2.9'; // % Fee
          if (v3) v3.value = '0.30'; // Fixed fee
          break;

        case 'break_even':
          v1.value = '12000'; // Fixed costs
          if (v2) v2.value = '15'; // Variable cost per unit
          if (v3) v3.value = '45'; // Price per unit
          break;

        case 'property_roi':
          v1.value = '24000'; // Annual income
          if (v2) v2.value = '350000'; // Property value
          break;

        case 'multiply3':
          v1.value = '35'; // Hourly rate
          if (v2) v2.value = '40'; // Hours/week
          if (v3) v3.value = '52'; // Weeks
          break;

        case 'crypto':
          v1.value = '2000'; // Investment
          if (v2) v2.value = '3400'; // Current value
          break;

        case 'clv':
          v1.value = '150'; // Avg purchase
          if (v2) v2.value = '4'; // Purchases/yr
          if (v3) v3.value = '3'; // Years
          break;

        case 'depreciation':
          v1.value = '25000'; // Cost
          if (v2) v2.value = '4000'; // Salvage
          if (v3) v3.value = '5'; // Years
          break;

        case 'eps':
          v1.value = '500000'; // Net income
          if (v2) v2.value = '50000'; // Dividends
          if (v3) v3.value = '100000'; // Shares
          break;

        case 'retention':
          v1.value = '500'; // Start customers
          if (v2) v2.value = '70'; // New added
          if (v3) v3.value = '490'; // End count
          break;

        case 'real_estate':
          v1.value = '36000'; // Gross rent
          if (v2) v2.value = '11000'; // Operating expenses
          if (v3) v3.value = '380000'; // Property value
          break;

        case 'platform_margin':
          v1.value = '60'; // Selling price
          if (v2) v2.value = '18'; // COGS
          if (v3) v3.value = '12'; // Platform fees
          break;

        case 'savings_goal':
          v1.value = '50000'; // Goal
          if (v2) v2.value = '6'; // Interest %
          if (v3) v3.value = '60'; // Months
          break;

        case 'retirement':
          v1.value = '4000'; // Monthly expense
          if (v2) v2.value = '30'; // Years
          if (v3) v3.value = '4'; // SWR %
          break;

        case 'freelance_tax':
          v1.value = '85000'; // Gross income
          if (v2) v2.value = '12000'; // Expenses
          if (v3) v3.value = '15'; // Tax bracket %
          break;

        case 'invoice_discount':
          v1.value = '2500'; // Invoice total
          if (v2) v2.value = '10'; // Discount %
          if (v3) v3.value = '5'; // Tax %
          break;

        case 'markup':
          v1.value = '45'; // Cost price
          if (v2) v2.value = '35'; // Margin %
          break;

        case 'email_roi':
          v1.value = '10000'; // Total sent
          if (v2) v2.value = '2800'; // Opens
          if (v3) v3.value = '1400'; // Revenue
          break;

        case 'payroll_tax':
          v1.value = '75000'; // Annual salary
          if (v2) v2.value = '12'; // Pay periods
          break;

        case 'rent_vs_buy':
          v1.value = '400000'; // Home Price
          if (v2) v2.value = '2200'; // Monthly Rent
          if (v3) v3.value = '7'; // Years
          break;

        default:
          if (v1 && !v1.value) v1.value = '10000';
          if (v2 && !v2.value && v2.tagName === 'INPUT') v2.value = '10';
          if (v3 && !v3.value && v3.tagName === 'INPUT') v3.value = '5';
          break;
      }
    }

    // ✨ পেজ লোড হওয়ার সাথে সাথে ডিফল্ট ডেটা লোড হয়ে অটো রান করবে
    window.addEventListener('DOMContentLoaded', () => {
      loadDemoData();
      if (btn) {
        btn.click();
      }
    });
  </script>

  <script define:vars={{ f: calc.formula, n: calc.name }}>
    window.currentFormula = f;
    window.currentName    = n;
  </script>
</Layout>
