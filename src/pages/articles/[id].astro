---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('articles');
  return posts.map(post => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const { title, description, keywords, author, date, dateModified, emoji, category, readTime, image } = post.data;
---

<Layout 
  title={title} 
  description={description} 
  keywords={keywords}
  image={image}
  pageType="article"
  datePublished={date}
  dateModified={dateModified || date}
  author={author}
>
  <style>
    .article-header {
      background: linear-gradient(135deg, #1e3a8a 0%, #0f172a 100%);
      color: white;
      padding: 40px 20px; 
      text-align: center;
      border-bottom: 3px solid var(--brand-accent, #d4a373);
      position: relative;
    }
    
    .emoji-hero { 
      font-size: 2.2rem; 
      margin-bottom: 8px; 
    }

    .category-badge {
      color: var(--brand-accent, #d4a373);
      font-weight: 700;
      text-transform: uppercase;
      font-size: 0.75rem;
      letter-spacing: 1.5px;
      display: inline-block;
      margin-bottom: 8px;
    }

    h1 { 
      font-family: var(--serif, 'Crimson Pro', serif); 
      font-size: 2.2rem !important; 
      margin: 10px auto;
      max-width: 850px;
      line-height: 1.25;
      font-weight: 800;
    }

    .meta-info {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 16px;
      margin-top: 14px;
      font-size: 0.85rem;
      opacity: 0.9;
    }

    .featured-image-wrapper {
      max-width: 850px;
      margin: 30px auto 0;
      padding: 0 20px;
    }

    .featured-image {
      width: 100%;
      height: auto;
      max-height: 420px;
      object-fit: cover;
      border-radius: 16px;
      box-shadow: 0 15px 40px rgba(0,0,0,0.15);
      border: 1px solid #e2e8f0;
    }

    .content-area {
      max-width: 850px;
      margin: 0 auto;
      padding: 30px 20px 60px;
      line-height: 1.8;
      font-size: 1.1rem;
      color: #334155;
    }

    /* ✨ SEO Breadcrumb Bar */
    .breadcrumb-nav {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 0.85rem;
      color: #64748b;
      margin-bottom: 25px;
      padding-bottom: 12px;
      border-bottom: 1px solid #f1f5f9;
    }

    .breadcrumb-nav a {
      color: #1e3a8a;
      text-decoration: none;
      font-weight: 600;
    }

    .breadcrumb-nav a:hover {
      text-decoration: underline;
    }

    .breadcrumb-separator {
      color: #cbd5e1;
    }

    @media (max-width: 768px) {
      h1 { font-size: 1.6rem !important; }
      .article-header { padding: 25px 15px; }
      .emoji-hero { font-size: 1.8rem; }
      .featured-image { max-height: 240px; }
      .content-area { padding: 20px 15px 40px; font-size: 1rem; }
    }
  </style>

  <header class="article-header">
    <div class="emoji-hero">{emoji}</div>
    <span class="category-badge">{category}</span>
    <h1>{title}</h1>
    
    <div class="meta-info">
      <span>📅 {date}</span>
      <span>⏱️ {readTime}</span>
      {author && <span>🛡️ {author}</span>}
    </div>
  </header>

  {image && (
    <div class="featured-image-wrapper">
      <img src={image} alt={title} class="featured-image" loading="eager" />
    </div>
  )}

  <main class="content-area">
    <!-- ✨ Clean Breadcrumb Navigation -->
    <nav class="breadcrumb-nav" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span class="breadcrumb-separator">/</span>
      <a href="/articles">Guides</a>
      <span class="breadcrumb-separator">/</span>
      <span style="color: #94a3b8; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 300px;">{title}</span>
    </nav>
    
    <article class="prose lg:prose-xl max-w-none">
      <Content />
    </article>
    
    <hr style="margin: 40px 0; border: 0; border-top: 1px solid #e2e8f0;" />
    
    <div style="background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%); padding: 30px 20px; border-radius: 16px; text-align: center; border: 1px solid #e2e8f0; box-shadow: 0 4px 20px rgba(0,0,0,0.03);">
      <h3 style="color: #1e3a8a; margin-bottom: 8px; font-size: 1.3rem; font-family: 'Crimson Pro', serif; font-weight: 700;">Need a precise calculation?</h3>
      <p style="color: #64748b; font-size: 0.95rem; max-width: 500px; margin: 0 auto 16px;">Try our free interactive calculators for instant loan, tax, and investment results.</p>
      <a href="/" style="display: inline-block; padding: 12px 28px; background: #1e3a8a; color: white; text-decoration: none; border-radius: 8px; font-weight: 700; font-size: 0.95rem; transition: 0.2s;">Explore All Calculators →</a>
    </div>
  </main>
</Layout>
